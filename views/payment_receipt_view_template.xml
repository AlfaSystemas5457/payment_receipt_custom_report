<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="payment_receipt_view_template">
        <h3>
            <strong>POLIZA DE PAGO: <span t-field="o.name" /></strong>
        </h3>

        <div class="row mt64">
            <div class="col-6" t-if="o.payment_date">
                <strong>Fecha del Pago: </strong>
                <span t-field="o.payment_date" />
            </div>
        </div>

        <div class="row">
            <div class="col-6" t-if="o.partner_type">
                <t t-if="o.partner_type == 'customer'">
                    <strong>Cliente: </strong>
                </t>
                <t t-if="o.partner_type == 'supplier'">
                    <strong>Proveedor: </strong>
                </t>
                <span t-field="o.partner_id" />
            </div>
        </div>

        <div class="row mb64">
            <div class="col-6" t-if="o.amount">
                <strong>Importe del pago: </strong>
                <span t-field="o.amount"
                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
            </div>
        </div>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>
                        <span>FECHA DE FACTURA</span>
                    </th>
                    <th>
                        <span>FOLIO INTERNO</span>
                    </th>
                    <th>
                        <span>FACTURA #</span>
                    </th>
                    <th class="text-right">
                        <span>SUB TOTAL</span>
                    </th>
                    <th class="text-right">
                        <span>IVA</span>
                    </th>
                    <th class="text-right">
                        <span>TOTAL</span>
                    </th>
                </tr>
            </thead>

            <tbody>
                <tr t-foreach="o.reconciled_invoice_ids" t-as="inv">
                    <td>
                        <span t-field="inv.date_invoice" />
                    </td>
                    <td>
                        <span t-field="inv.number" />
                    </td>
                    <td>
                        <span t-field="inv.reference" />
                    </td>
                    <td class="text-right">
                        <span t-field="inv.amount_untaxed_invoice_signed" />
                    </td>
                    <td class="text-right">
                        <span t-field="inv.amount_tax_signed" />
                    </td>
                    <td class="text-right">
                        <span t-field="inv.amount_total_signed" />
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="row my-5 p-2 justify-content-end">
            <div class="mr-2" style="font-size: 25px;" t-if="o.amount">
                <strong>Total pagado: </strong>
                <span t-field="o.amount"
                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
            </div>
        </div>
    </template>
</odoo>